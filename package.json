{
  "name": "toothlogy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/audit-assets.mjs --summary && prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "db:studio": "prisma studio",
    "registry:validate": "vitest run tests/registry",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run docs:check",
    "docs:divisions": "node --experimental-strip-types --no-warnings scripts/generate-division-docs.mts",
    "docs:check": "node scripts/check-doc-links.cjs",
    "db:seed": "node --experimental-strip-types --no-warnings prisma/seed.mts",
    "assets:sync": "node scripts/sync-asset-manifest.mjs",
    "assets:audit": "node scripts/audit-assets.mjs",
    "db:reset": "prisma migrate reset --force",
    "docs:all": "npm run docs:divisions && npm run docs:check"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "happy-dom": "^20.14.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  },
  "description": "Toothlogy \u2014 global dental ecosystem. Phase 0 foundation.",
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
