# TOOTHLOGY — ENVIRONMENT TEMPLATE
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored and must NEVER be
# committed (Constitution §9). This file contains NAMES and SHAPES only — never
# a real value, not even a "test" one, because test credentials get promoted.
#
# The foundation runs with none of these set: `npm run dev`, `npm run build`,
# `npm run lint` and `npm test` all work with no database and no providers.
# Missing configuration is reported honestly rather than faked (Constitution P10).

# --- Core ------------------------------------------------------------------

NODE_ENV=development

# MySQL connection string. REQUIRED in production; optional in development.
#
# Shape, in order:  mysql  ://  USERNAME  :  PASSWORD  @  HOST  :3306/  DATABASE_NAME
#
# Written spaced out on purpose: the secret scanner treats a credential-shaped
# connection string as a finding wherever it appears, INCLUDING in this file —
# a placeholder in the exact form of a real URL fails it too. That is the
# correct posture; this is the file a real value is most likely to be pasted
# into by accident.
#
# Production (Hostinger): the host, database name and user are shown in hPanel
# under Databases. Append these query parameters to the URL:
#   connection_limit=3   Each serverless instance opens its own pool, and a
#                        shared host caps connections per user. Keep it small.
#   pool_timeout=20      Wait for a free connection rather than failing fast.
# Set the real value ONLY in the deployment's environment settings, never in a
# file in this repository.
#
# Local development: any MySQL 8.0+ (or MariaDB 10.6+) you control. The user
# needs ALL PRIVILEGES on its own database — the same grant a Hostinger user
# gets. `npm run db:deploy` applies migrations; never point `db:migrate` or
# `db:reset` at a database that holds real data.
# DATABASE_URL=

# Session signing key. REQUIRED in production. Minimum 32 characters, unique per
# environment. Generate with:  openssl rand -base64 48
# Rotating it signs everyone out — that is the intended emergency behaviour.
# SESSION_SECRET=

LOG_LEVEL=info

# --- Public (sent to the browser) ------------------------------------------
# Only NEXT_PUBLIC_ variables reach client JavaScript. Never put a secret behind
# this prefix — the registry integrity test rejects it, and it would be bundled.

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_COUNTRY=IN
NEXT_PUBLIC_DEFAULT_LOCALE=en

# --- Feature flag overrides ------------------------------------------------
# TL_FLAG_<UPPER_KEY>. Accepts a state name (disabled/development/beta/enabled/
# deprecated) or a boolean spelling (true/false/on/off/1/0).
#
# TL_FLAG_DESIGN_SYSTEM_REFERENCE=enabled
# TL_FLAG_REGISTRY_INTROSPECTION_API=enabled
# TL_FLAG_VERBOSE_HEALTH_CHECK=enabled
# TL_FLAG_MULTI_LOCALE_ROUTING=disabled

# ===========================================================================
# INTEGRATIONS — all NOT CONFIGURED in Phase 0
#
# No adapter is wired for any of these. Setting a variable alone does nothing
# until the corresponding adapter is implemented in a later phase. Until then
# every call returns a typed NOT_CONFIGURED error rather than a fake success.
#
# Names below are generated from src/registry/integrations.ts.
# ===========================================================================

# --- Email (TL-INT-EMAIL-001) ---
# EMAIL_PROVIDER=
# EMAIL_API_KEY=
# EMAIL_FROM_ADDRESS=
# EMAIL_FROM_NAME=

# --- SMS (TL-INT-SMS-001) ---
# India requires DLT-registered templates; the template ID is configuration.
# SMS_PROVIDER=
# SMS_API_KEY=
# SMS_SENDER_ID=

# --- WhatsApp (TL-INT-WHATSAPP-001) ---
# WHATSAPP_PROVIDER=
# WHATSAPP_API_KEY=
# WHATSAPP_PHONE_NUMBER_ID=

# --- Push (TL-INT-PUSH-001) ---
# PUSH_PROVIDER=
# PUSH_API_KEY=
# PUSH_VAPID_PUBLIC_KEY=
# PUSH_VAPID_PRIVATE_KEY=

# --- Payments (TL-INT-PAYMENT-001) ---
# Razorpay for India, Stripe elsewhere — which is why the port exists.
# PAYMENT_PROVIDER=
# PAYMENT_API_KEY=
# PAYMENT_API_SECRET=
# PAYMENT_WEBHOOK_SECRET=

# --- Object storage (TL-INT-STORAGE-001) ---
# STORAGE_PROVIDER=
# STORAGE_BUCKET=
# STORAGE_REGION=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=

# --- Maps and geocoding (TL-INT-MAPS-001) ---
# MAPS_PROVIDER=
# MAPS_API_KEY=

# --- Search (TL-INT-SEARCH-001) ---
# SEARCH_PROVIDER=
# SEARCH_HOST=
# SEARCH_API_KEY=

# --- Analytics (TL-INT-ANALYTICS-001) ---
# ANALYTICS_PROVIDER=
# ANALYTICS_WRITE_KEY=

# --- Error tracking (TL-INT-ERRORS-001) ---
# ERROR_TRACKING_DSN=
# ERROR_TRACKING_ENVIRONMENT=

# --- AI (TL-INT-AI-001) — Phase 11, bound by the AI covenant (Constitution §5)
# AI_PROVIDER=
# AI_API_KEY=
# AI_MODEL=
